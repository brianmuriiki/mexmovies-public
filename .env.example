# Where the API lives. In development leave it as /api (the Vite proxy forwards it to localhost:5000).
# In production behind the Cloudflare Pages proxy (see ../DEPLOY.md) it is also /api.
VITE_API_URL=/api

# Optional: load the catalog from a static file instead of the API
# (for example the R2 address of catalog/catalog.json). Leave empty to use /api/catalog.
VITE_CATALOG_URL=

# Shown on the About, Terms, and Privacy pages. Set this before launch.
VITE_CONTACT_EMAIL=

# Optional: Cloudflare Turnstile site key (the bot check on sign-up). Leave empty to switch it off.
VITE_TURNSTILE_SITE_KEY=
